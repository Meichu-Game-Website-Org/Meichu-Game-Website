--- a/dist/cjs.js
+++ b/dist/cjs.js
@@ -80,10 +80,18 @@ function mergeObject(target, source, options) {
 	var destination = {};
 	if (options.isMergeableObject(target)) {
 		getKeys(target).forEach(function(key) {
+			// Never invoke the __proto__ setter, regardless of the target shape.
+			if (key === '__proto__') {
+				return
+			}
 			destination[key] = cloneUnlessOtherwiseSpecified(target[key], options);
 		});
 	}
 	getKeys(source).forEach(function(key) {
+		// Never invoke the __proto__ setter, regardless of the target shape.
+		if (key === '__proto__') {
+			return
+		}
 		if (propertyIsUnsafe(target, key)) {
 			return
 		}
